  "factors": [
    {"id": "momentum_60", "expression": "returns(close,60)", "direction": 1},
    {"id": "reversal_5", "expression": "returns(close,5)", "direction": -1},
    {"id": "volatility_20", "expression": "ts_std(returns(close,1),20)", "direction": -1},
    {"id": "illiquidity_20", "expression": "ts_mean(abs(returns(close,1))/max(amount,1),20)", "direction": -1},
    {"id": "range_position_20", "expression": "(close-ts_min(low,20))/(ts_max(high,20)-ts_min(low,20))", "direction": 1},
    {"id": "volume_variation_20", "expression": "ts_std(vol,20)/ts_mean(vol,20)", "direction": -1},
    {"id": "intraday_momentum_20", "expression": "ts_mean((close-open)/open,20)", "direction": 1},
    {"id": "downside_risk_20", "expression": "sqrt(ts_mean(min(returns(close,1),0)*min(returns(close,1),0),20))", "direction": -1}
  ],
  "preprocess": {"winsorize": true, "standardize": true},
  "model": {
